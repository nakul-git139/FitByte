{
  "expo": {
    "name": "FitPilot",
    "slug": "fitpilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F6F2"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FitPilot requires access to your camera to track your workout and live movement with real-time AI guidance."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F6F2"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitPilot to access your camera to track workouts.",
          "microphonePermission": "Allow FitPilot to access your microphone.",
          "recordAudioAndroid": false
        }
      ],
      "expo-asset"
    ]
  }
}
